{
  "name": "vendetuautoya-monorepo",
  "version": "1.0.0",
  "description": "Plataforma de subastas de vehículos - Frontend React + Backend .NET",
  "private": true,
  "workspaces": [
    "frontend"
  ],
  "scripts": {
    "dev:frontend": "cd frontend && npm run dev",
    "dev:backend": "cd backend/VendeTuAutoYa.Api && dotnet run --urls \"https://localhost:7001\"",
    "build:frontend": "cd frontend && npm run build",
    "build:backend": "cd backend/VendeTuAutoYa.Api && dotnet build -c Release",
    "install:frontend": "cd frontend && npm install",
    "install:backend": "cd backend/VendeTuAutoYa.Api && dotnet restore",
    "start:frontend": "cd frontend && npm start",
    "test:frontend": "cd frontend && npm test",
    "migrate:backend": "cd backend/VendeTuAutoYa.Api && dotnet ef database update",
    "setup": "npm run install:frontend && npm run install:backend",
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "build": "npm run build:backend && npm run build:frontend"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/juanmartin1413/vendetuautoya.git"
  },
  "keywords": [
    "react",
    "typescript",
    "dotnet",
    "entity-framework",
    "monorepo",
    "subastas",
    "vehiculos"
  ],
  "author": "Juan Martin <juanmartin1413@email.com>",
  "license": "MIT"
}